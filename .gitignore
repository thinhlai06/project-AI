# Chỉ đưa lên repo: tài liệu .md ở thư mục gốc + mô hình cuối. Mọi thứ khác (dữ liệu, venv, code thử nghiệm, output) giữ ở máy local.
/*
!/.gitignore
!/*.md

# Máy chủ AI (module suy luận + FastAPI)
!/backend/

# Sơ đồ pipeline
!/docs/

!/out/
/out/*

# Bản triển khai (ONNX + cấu hình + bảng tra chỉ lập từ train); detector.pt trùng với out/s2/det/d2b/weights/best.pt
!/out/onnx_final/
/out/onnx_final/detector.pt


# Detector cuối (PyTorch) + kết quả đo
!/out/s2/
/out/s2/*
!/out/s2/det/
/out/s2/det/*
!/out/s2/det/d2b/
/out/s2/det/d2b/*
!/out/s2/det/d2b/eval_val.json
!/out/s2/det/d2b/weights/
/out/s2/det/d2b/weights/*
!/out/s2/det/d2b/weights/best.pt

# Bộ nhận dạng cuối (PyTorch) + kết quả đo
!/out/s3/
/out/s3/*
!/out/s3/r3b_seed1/
/out/s3/r3b_seed1/*
!/out/s3/r3b_seed1/model.pt
!/out/s3/r3b_seed1/final.json

# Python cache
__pycache__/
*.pyc
